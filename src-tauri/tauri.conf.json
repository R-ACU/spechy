{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spechy",
  "version": "0.1.3",
  "identifier": "com.remo.spechy",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1433",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Spechy",
        "width": 1180,
        "height": 780,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": true,
        "visible": true,
        "theme": "Light",
        "backgroundColor": "#f3f1ee",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Remo",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 Remo",
    "shortDescription": "Voice dictation for Windows.",
    "longDescription": "Spechy turns speech into clean text in any app: hold a key, speak, release.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "installMode": "currentUser", "languages": ["German", "English"] } }
  }
}
